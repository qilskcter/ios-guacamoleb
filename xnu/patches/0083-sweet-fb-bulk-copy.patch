+static int
+sweet_lz4_decompress(const uint8_t *src, size_t src_len, uint8_t *dst, size_t dst_len)
+{
+	const uint8_t *src_end = src + src_len;
+	uint8_t *dst_orig = dst;
+	uint8_t *dst_end = dst + dst_len;
+
+	while (src < src_end) {
+		uint8_t token = *src++;
+		size_t lit_len = token >> 4;
+		if (lit_len == 15) {
+			uint8_t s;
+			do {
+				if (src >= src_end) return -1;
+				s = *src++;
+				lit_len += s;
+			} while (s == 255);
+		}
+		if (dst + lit_len > dst_end || src + lit_len > src_end) return -1;
+		memcpy(dst, src, lit_len);
+		dst += lit_len;
+		src += lit_len;
+		if (src >= src_end) break;
+		uint16_t offset = (uint16_t)((uint16_t)src[0] | ((uint16_t)src[1] << 8));
+		src += 2;
+		if (offset == 0) return -1;
+		size_t match_len = (token & 0x0f) + 4;
+		if (match_len == 19) {
+			uint8_t s;
+			do {
+				if (src >= src_end) return -1;
+				s = *src++;
+				match_len += s;
+			} while (s == 255);
+		}
+		const uint8_t *match = dst - offset;
+		if (match < dst_orig || dst + match_len > dst_end) return -1;
+		while (match_len--) {
+			*dst++ = *match++;
+		}
+	}
+	return (int)(dst - dst_orig);
+}
