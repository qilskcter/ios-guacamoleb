+static inline void
+sweet_fast_copy_row(uint8_t *dst, const uint8_t *src, size_t len)
+{
+	size_t n = len / 64;
+	const uint64_t *s = (const uint64_t *)(const void *)src;
+	uint64_t *d = (uint64_t *)(void *)dst;
+
+	while (n--) {
+		uint64_t a = s[0];
+		uint64_t b = s[1];
+		uint64_t c = s[2];
+		uint64_t d0 = s[3];
+		uint64_t e = s[4];
+		uint64_t f = s[5];
+		uint64_t g = s[6];
+		uint64_t h = s[7];
+		d[0] = a; d[1] = b; d[2] = c; d[3] = d0;
+		d[4] = e; d[5] = f; d[6] = g; d[7] = h;
+		s += 8;
+		d += 8;
+	}
+	len &= 63;
+	if (len >= 32) {
+		uint64_t a = s[0];
+		uint64_t b = s[1];
+		uint64_t c = s[2];
+		uint64_t d0 = s[3];
+		d[0] = a; d[1] = b; d[2] = c; d[3] = d0;
+		s += 4;
+		d += 4;
+		len -= 32;
+	}
+	if (len >= 16) {
+		uint64_t a = s[0];
+		uint64_t b = s[1];
+		d[0] = a; d[1] = b;
+		s += 2;
+		d += 2;
+		len -= 16;
+	}
+	if (len >= 8) {
+		*d++ = *s++;
+		len -= 8;
+	}
+	uint8_t *d8 = (uint8_t *)d;
+	const uint8_t *s8 = (const uint8_t *)s;
+	if (len >= 4) {
+		*(uint32_t *)(void *)d8 = *(const uint32_t *)(const void *)s8;
+		d8 += 4;
+		s8 += 4;
+		len -= 4;
+	}
+	while (len--) {
+		*d8++ = *s8++;
+	}
+}
