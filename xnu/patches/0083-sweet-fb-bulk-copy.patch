+							uint32_t rb_s = src_px & 0x00ff00ff;
+							uint32_t g_s  = (src_px >> 8) & 0x000000ff;
+							uint32_t rb_d = dst_px & 0x00ff00ff;
+							uint32_t g_d  = (dst_px >> 8) & 0x000000ff;
+							uint32_t rb = (((rb_s * a + rb_d * inv_a) + 0x00800080) >> 8) & 0x00ff00ff;
+							uint32_t g  = (((g_s * a + g_d * inv_a) + 0x00000080) >> 8) & 0x000000ff;
+							dp[x] = 0xff000000 | rb | (g << 8);
