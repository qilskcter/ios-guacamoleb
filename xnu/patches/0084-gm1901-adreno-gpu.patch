+/*
+ * Qualcomm Adreno 640 hardware graphics accelerator driver for OnePlus 7 (SM8150).
+ *
+ * Powers on and sequences Adreno 640 GPUCC GDSC and clocks, boosts SM8150
+ * Kryo 485 CPU & L3 OSM performance states, and applies QuartzCore
+ * CABackdropLayer software downsample fixup.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/system.h>
+#include <pexpert/pexpert.h>
+#include <mach/mach_types.h>
+#include <machine/machine_routines.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" void *vm_shared_region_get(task_t task);
+extern "C" void vm_shared_region_deallocate(void *sr);
+extern "C" ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern "C" vm_offset_t phystokv(uint64_t pa);
+extern "C" void sweet_fixup_quartzcore(task_t task);
+
+static bool
+sweet_patch_user_insn(pmap_t pmap, uint64_t uaddr, uint32_t expected, uint32_t replacement)
+{
+	uint32_t insn = 0;
+	if (copyin((user_addr_t)uaddr, &insn, sizeof(insn)) != 0) {
+		return false;
+	}
+	if (insn == replacement) {
+		return true;
+	}
+	if (insn != expected) {
+		IOLog("SWEET QC: unexpected insn 0x%08x (want 0x%08x) at 0x%llx\n",
+		    insn, expected, uaddr);
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(pmap, (addr64_t)uaddr);
+	if (pn == 0) {
+		return false;
+	}
+	uint64_t pa = ((uint64_t)pn << 14) | (uaddr & 0x3fffULL);
+	vm_offset_t kva = phystokv(pa);
+	if (kva == 0) {
+		return false;
+	}
+	*(volatile uint32_t *)kva = replacement;
+	__asm__ volatile(
+	    "dc civac, %0\n\t"
+	    "dsb ish\n\t"
+	    "ic ialluis\n\t"
+	    "dsb ish\n\t"
+	    "isb"
+	    : : "r"(kva) : "memory");
+	return true;
+}
+
+/*
+ * SWEET: Fix QuartzCore's CA::OGL::capture_backdrop so that:
+ * 1. At unslid 0x18831580c: use nearest-neighbor sampling (mov w8, #0) instead
+ *    of 4-tap floating-point bilinear interpolation (cset w8, ne) when sampling
+ *    background layers into the backdrop buffer prior to Gaussian blur.
+ * 2. At unslid 0x188315a74: force image_func = 1 (b 0x188315b08) when
+ *    scale < 0.5 (e.g. Home Screen Dock at scale = 0.25) instead of GL-only
+ *    image_func = 26/28 rejected by SWContext::function_supported.
+ */
+extern "C" void
+sweet_fixup_quartzcore(task_t task)
+{
+	static int sweet_qc_patched = 0;
+	if (sweet_qc_patched || task == NULL) {
+		return;
+	}
+	void *sr = vm_shared_region_get(task);
+	if (sr == NULL) {
+		return;
+	}
+	uint64_t slide = *(uint32_t *)((uintptr_t)sr + 4);
+	vm_shared_region_deallocate(sr);
+
+	pmap_t pmap = get_task_pmap(task);
+	if (pmap == NULL) {
+		return;
+	}
+	bool ok1 = sweet_patch_user_insn(pmap, 0x18831580cULL + slide,
+	    0x1a9f07e8U, 0x52800008U);
+	bool ok2 = sweet_patch_user_insn(pmap, 0x188315a74ULL + slide,
+	    0x540004aaU, 0x14000025U);
+	if (ok1 && ok2) {
+		sweet_qc_patched = 1;
+		IOLog("SWEET QC: backdrop blur & fast sampling fixup applied (slide 0x%llx)\n", slide);
+	}
+}
+
+/* Qualcomm SM8150 GPU Subsystem MMIO bases & sizes */
+#define ADRENO_GPUCC_BASE_PHYS 0x02C90000ULL
+#define ADRENO_GPUCC_SIZE      0x9000ULL
+#define ADRENO_GPU_BASE_PHYS   0x02C00000ULL
+#define ADRENO_GPU_SIZE        0x40000ULL
+#define ADRENO_GMU_BASE_PHYS   0x02C6A000ULL
+#define ADRENO_GMU_SIZE        0x30000ULL
+
+/* GPUCC GDSC and Clock Branch offsets */
+#define GPUCC_CX_GDSC_OFFSET   0x9108
+#define GPUCC_GX_GDSC_OFFSET   0x905C
+#define GPUCC_AHB_CLK_OFFSET   0x1078
+#define GPUCC_CX_GMU_OFFSET    0x1098
+#define GPUCC_GX_GFX3D_OFFSET  0x1054
+
+#define CHIP_ID_ADRENO_640     0x06040001U
+
+/* Qualcomm SM8150 OSM (Operating State Manager) physical base & domain offsets */
+#define SM8150_OSM_PHYS_BASE   0x18320000ULL
+#define SM8150_OSM_MAP_SIZE    0x0000C000ULL
+#define OSM_OFF_L3             0x1000U
+#define OSM_OFF_SILVER         0x3000U
+#define OSM_OFF_GOLD           0x5800U
+#define OSM_OFF_PRIME          0x7800U
+#define OSM_REG_ENABLE         0x000U
+#define OSM_REG_LUT_BASE       0x110U
+#define OSM_REG_PERF_DESIRED   0x920U
+#define OSM_LUT_ROW_STRIDE     0x20U
+#define OSM_LUT_MAX_ROWS       40U
+
+class SweetAccelerator : public IOService {
+	OSDeclareDefaultStructors(SweetAccelerator);
+
+public:
+	volatile uint32_t *fGpuccBase;
+	volatile uint32_t *fGpuBase;
+	volatile uint32_t *fGmuBase;
+	uint32_t           fChipId;
+	IOLock            *fLock;
+
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+	void boostCPUClocks();
+	bool powerOnGPU();
+	uint32_t readChipID();
+};
+
+OSDefineMetaClassAndStructors(SweetAccelerator, IOService);
+
+bool
+SweetAccelerator::init(OSDictionary *dictionary)
+{
+	if (!IOService::init(dictionary)) {
+		return false;
+	}
+	fGpuccBase = NULL;
+	fGpuBase = NULL;
+	fGmuBase = NULL;
+	fChipId = CHIP_ID_ADRENO_640;
+	fLock = NULL;
+	return true;
+}
+
+void
+SweetAccelerator::free()
+{
+	if (fLock) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOService::free();
+}
+
+void
+SweetAccelerator::boostCPUClocks()
+{
+	uintptr_t osm_base = (uintptr_t)ml_io_map(SM8150_OSM_PHYS_BASE, SM8150_OSM_MAP_SIZE);
+	if (osm_base == 0) {
+		IOLog("SWEET CPU: Failed to map SM8150 OSM\n");
+		return;
+	}
+	static const uint32_t dom_offsets[4] = {
+		OSM_OFF_L3, OSM_OFF_SILVER, OSM_OFF_GOLD, OSM_OFF_PRIME
+	};
+	static const char *dom_names[4] = {
+		"L3", "Silver", "Gold", "Prime"
+	};
+	for (int d = 0; d < 4; d++) {
+		uintptr_t dom = osm_base + dom_offsets[d];
+		uint32_t en = *(volatile uint32_t *)(dom + OSM_REG_ENABLE);
+		if (!(en & 1U)) {
+			continue;
+		}
+		uint32_t max_idx = 0;
+		uint32_t prev_lval = 0, prev_src = 0;
+		uint32_t max_lval = 0;
+		for (uint32_t i = 0; i < OSM_LUT_MAX_ROWS; i++) {
+			uint32_t val = *(volatile uint32_t *)(dom + OSM_REG_LUT_BASE + i * OSM_LUT_ROW_STRIDE);
+			uint32_t lval = val & 0xffU;
+			uint32_t src = (val >> 30) & 0x3U;
+			if (lval == 0 && src == 0) {
+				break;
+			}
+			if (i > 0 && lval == prev_lval && src == prev_src) {
+				break;
+			}
+			max_idx = i;
+			max_lval = lval;
+			prev_lval = lval;
+			prev_src = src;
+		}
+		if (max_idx > 0) {
+			uint32_t old_idx = *(volatile uint32_t *)(dom + OSM_REG_PERF_DESIRED);
+			*(volatile uint32_t *)(dom + OSM_REG_PERF_DESIRED) = max_idx;
+			(void)*(volatile uint32_t *)(dom + OSM_REG_ENABLE);
+			__asm__ volatile("dsb sy" ::: "memory");
+			IOLog("SWEET CPU: %s OSM idx %u -> %u (~%u MHz)\n",
+			    dom_names[d], old_idx & 0x3fU, max_idx, (max_lval * 192U) / 10U);
+		}
+	}
+}
+
+bool
+SweetAccelerator::powerOnGPU()
+{
+	/* Map GPU Clock Controller (GPUCC) at 0x02C90000 */
+	fGpuccBase = (volatile uint32_t *)ml_io_map(ADRENO_GPUCC_BASE_PHYS, ADRENO_GPUCC_SIZE);
+	if (fGpuccBase == NULL) {
+		IOLog("SWEET GPU: Failed to map GPUCC\n");
+		return false;
+	}
+
+	/* Hardware Power-up Sequence */
+	volatile uint32_t *cx_gdsc = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_CX_GDSC_OFFSET);
+	volatile uint32_t *gx_gdsc = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_GX_GDSC_OFFSET);
+	volatile uint32_t *ahb_clk = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_AHB_CLK_OFFSET);
+	volatile uint32_t *gmu_clk = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_CX_GMU_OFFSET);
+	volatile uint32_t *gfx_clk = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_GX_GFX3D_OFFSET);
+
+	/* Step 1: Enable CX GDSC */
+	*cx_gdsc |= 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (int i = 0; i < 5000; i++) {
+		if (*cx_gdsc & 0x80000000U) break;
+		IODelay(1);
+	}
+
+	/* Step 2 & 3: Enable AHB and GMU branch clocks */
+	*ahb_clk |= 1;
+	*gmu_clk |= 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* Step 4: Enable GX GDSC (3D graphics core) */
+	*gx_gdsc |= 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (int i = 0; i < 5000; i++) {
+		if (*gx_gdsc & 0x80000000U) break;
+		IODelay(1);
+	}
+
+	/* Step 5: Enable GFX3D core clock */
+	*gfx_clk |= 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	IOLog("SWEET GPU: Hardware clocks and GDSC active\n");
+	return true;
+}
+
+uint32_t
+SweetAccelerator::readChipID()
+{
+	if (fGpuBase != NULL) {
+		uint32_t id = *fGpuBase;
+		if (id != 0 && id != 0xffffffffU) {
+			return id;
+		}
+	}
+	return CHIP_ID_ADRENO_640;
+}
+
+bool
+SweetAccelerator::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+
+	fLock = IOLockAlloc();
+	boostCPUClocks();
+	powerOnGPU();
+	fGmuBase = (volatile uint32_t *)ml_io_map(ADRENO_GMU_BASE_PHYS, ADRENO_GMU_SIZE);
+	fGpuBase = (volatile uint32_t *)ml_io_map(ADRENO_GPU_BASE_PHYS, ADRENO_GPU_SIZE);
+	fChipId = readChipID();
+	IOLog("SWEET GPU: Adreno 640 hardware accelerator active\n");
+
+	setName("SweetAccelerator");
+	setProperty("IOGPUDevice", kOSBooleanTrue);
+	setProperty("IOGPUFamily", "Generic");
+	setProperty("IOGPUGL", kOSBooleanTrue);
+	setProperty("IOGPUMetal", kOSBooleanTrue);
+	setProperty("MetalPluginName", "SweetAccelerator");
+	setProperty("IOGPUNumCommandQueues", 4ULL, 32);
+	setProperty("IOGPUMaxSurfaces", 64ULL, 32);
+	setProperty("IOGPUGlobalSharedStorageSize", 0x10000000ULL, 64);
+	setProperty("IOGPUFeatureFlags", 0x1fULL, 32);
+	setProperty("IOGPUPerformanceLevel", 3ULL, 32);
+	setProperty("IOUserClientClass", "SweetAcceleratorUserClient");
+
+	registerService();
+	return true;
+}
+
+void
+SweetAccelerator::stop(IOService *provider)
+{
+	IOService::stop(provider);
+}
+
+class SweetAcceleratorUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetAcceleratorUserClient);
+
+public:
+	SweetAccelerator *fDriver;
+	task_t            fTask;
+
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetAcceleratorUserClient, IOUserClient);
+
+bool
+SweetAcceleratorUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fDriver = NULL;
+	return true;
+}
+
+bool
+SweetAcceleratorUserClient::start(IOService *provider)
+{
+	fDriver = OSDynamicCast(SweetAccelerator, provider);
+	if (fDriver == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	return true;
+}
+
+IOReturn
+SweetAcceleratorUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAcceleratorUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	if (args->scalarOutputCount > 0) {
+		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+			args->scalarOutput[i] = 0;
+		}
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	switch (selector) {
+	case 0:
+		if (args->scalarOutputCount > 0) {
+			args->scalarOutput[0] = 1;
+		}
+		break;
+	case 1:
+		break;
+	case 2:
+		if (args->scalarOutputCount > 0) {
+			args->scalarOutput[0] = 1;
+		}
+		break;
+	case 7:
+		if (args->scalarOutputCount >= 2) {
+			args->scalarOutput[0] = CHIP_ID_ADRENO_640;
+			args->scalarOutput[1] = 0x00010000;
+		}
+		break;
+	case 9:
+		if (args->scalarOutputCount > 0) {
+			args->scalarOutput[0] = 0x1000;
+		}
+		break;
+	case 12:
+	case 14:
+	case 17:
+	case 20:
+	default:
+		break;
+	}
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
