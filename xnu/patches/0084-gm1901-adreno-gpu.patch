+/*
+ * Qualcomm Adreno 640 hardware graphics accelerator driver for OnePlus 7 (SM8150).
+ *
+ * Powers on and sequences Adreno 640 GPUCC GDSC and clocks, boosts SM8150
+ * Kryo 485 CPU & L3 OSM performance states, applies QuartzCore CABackdropLayer
+ * software downsample fixup, and implements Linux MSM DRM / freedreno GEM
+ * IOUserClient architecture for HakiosMetal acceleration.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOSubMemoryDescriptor.h>
+#include <IOKit/system.h>
+#include <pexpert/pexpert.h>
+#include <mach/mach_types.h>
+#include <mach/mach_time.h>
+#include <mach/vm_param.h>
+#include <machine/machine_routines.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" void *vm_shared_region_get(task_t task);
+extern "C" void vm_shared_region_deallocate(void *sr);
+extern "C" ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern "C" vm_offset_t phystokv(uint64_t pa);
+extern "C" void sweet_fixup_quartzcore(task_t task);
+
+static bool
+sweet_patch_user_insn(pmap_t pmap, uint64_t uaddr, uint32_t expected, uint32_t replacement)
+{
+	uint32_t insn = 0;
+	if (copyin((user_addr_t)uaddr, &insn, sizeof(insn)) != 0) {
+		return false;
+	}
+	if (insn == replacement) {
+		return true;
+	}
+	if (insn != expected) {
+		IOLog("SWEET QC: unexpected insn 0x%08x (want 0x%08x) at 0x%llx\n",
+		    insn, expected, uaddr);
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(pmap, (addr64_t)uaddr);
+	if (pn == 0) {
+		return false;
+	}
+	uint64_t pa = ((uint64_t)pn << 14) | (uaddr & 0x3fffULL);
+	vm_offset_t kva = phystokv(pa);
+	if (kva == 0) {
+		return false;
+	}
+	*(volatile uint32_t *)kva = replacement;
+	__asm__ volatile(
+	    "dc civac, %0\n\t"
+	    "dsb ish\n\t"
+	    "ic ialluis\n\t"
+	    "dsb ish\n\t"
+	    "isb"
+	    : : "r"(kva) : "memory");
+	return true;
+}
+
+extern "C" void
+sweet_fixup_quartzcore(task_t task)
+{
+	static int sweet_qc_attempted = 0;
+	if (sweet_qc_attempted || task == NULL) {
+		return;
+	}
+	sweet_qc_attempted = 1;
+	void *sr = vm_shared_region_get(task);
+	if (sr == NULL) {
+		return;
+	}
+	uint64_t slide = *(uint32_t *)((uintptr_t)sr + 4);
+	vm_shared_region_deallocate(sr);
+
+	pmap_t pmap = get_task_pmap(task);
+	if (pmap == NULL) {
+		return;
+	}
+	bool ok = sweet_patch_user_insn(pmap, 0x188315a74ULL + slide,
+	    0x540004aaU, 0x14000025U);
+	if (ok) {
+		IOLog("SWEET QC: backdrop blur & fast downsample fixup applied (slide 0x%llx)\n", slide);
+	}
+}
+
+/* Qualcomm SM8150 GPU Subsystem MMIO bases & sizes */
+#define ADRENO_GPUCC_BASE_PHYS 0x02C90000ULL
+#define ADRENO_GPUCC_SIZE      0x9000ULL
+#define ADRENO_GPU_BASE_PHYS   0x02C00000ULL
+#define ADRENO_GPU_SIZE        0x40000ULL
+#define ADRENO_GMU_BASE_PHYS   0x02C6A000ULL
+#define ADRENO_GMU_SIZE        0x30000ULL
+
+/* GPUCC GDSC and Clock Branch offsets */
+#define GPUCC_CX_GDSC_OFFSET   0x9108
+#define GPUCC_GX_GDSC_OFFSET   0x905C
+#define GPUCC_AHB_CLK_OFFSET   0x1078
+#define GPUCC_CX_GMU_OFFSET    0x1098
+#define GPUCC_GX_GFX3D_OFFSET  0x1054
+
+#define CHIP_ID_ADRENO_640     0x06040001U
+
+/* Qualcomm SM8150 OSM physical base & domain offsets */
+#define SM8150_OSM_PHYS_BASE   0x18320000ULL
+#define SM8150_OSM_MAP_SIZE    0x0000C000ULL
+#define OSM_OFF_L3             0x1000U
+#define OSM_OFF_SILVER         0x3000U
+#define OSM_OFF_GOLD           0x5800U
+#define OSM_OFF_PRIME          0x7800U
+#define OSM_REG_LUT_BASE       0x110U
+#define OSM_REG_PERF_DESIRED   0x920U
+#define OSM_LUT_ROW_STRIDE     0x20U
+#define OSM_LUT_MAX_ROWS       40U
+
+/* Linux MSM DRM IOUserClient interface numbers */
+enum {
+	kDrmGemClose            = 0x09,
+	kMsmGetParam            = 0x40,
+	kMsmSetParam            = 0x41,
+	kMsmGemNew              = 0x42,
+	kMsmGemInfo             = 0x43,
+	kMsmGemCpuPrep          = 0x44,
+	kMsmGemCpuFini          = 0x45,
+	kMsmGemSubmit           = 0x46,
+	kMsmWaitFence           = 0x47,
+	kMsmGemMadvise          = 0x48,
+	kMsmSubmitQueueNew      = 0x4a,
+	kMsmSubmitQueueClose    = 0x4b,
+	kMsmSubmitQueueQuery    = 0x4c,
+	kHakiosSurface          = 0x7e,
+	kHakiosShow             = 0x7f,
+};
+
+#define MSM_PARAM_GPU_ID        0x01
+#define MSM_PARAM_GMU_FEATURE   0x02
+#define MSM_PARAM_CHIP_ID       0x03
+#define MSM_PARAM_MAX_FREQ      0x04
+#define MSM_PARAM_TIMESTAMP     0x05
+#define MSM_PARAM_VA_START      0x06
+#define MSM_PARAM_VA_SIZE       0x07
+
+#define MSM_INFO_GET_OFFSET     0
+#define MSM_INFO_GET_IOVA       1
+#define MSM_INFO_SET_NAME       2
+#define MSM_INFO_GET_FLAGS      5
+
+#define GPU_BUFFERS             1024
+#define GPU_VA_BASE             0x100000000ULL
+#define GPU_VA_STRIDE           0x001000000ULL /* 16 MB per buffer VA slot */
+
+struct msm_timespec {
+	int64_t seconds;
+	int64_t nanoseconds;
+};
+
+struct msm_param {
+	uint32_t pipe;
+	uint32_t param;
+	uint64_t value;
+	uint32_t len;
+	uint32_t pad;
+};
+
+struct msm_gem_new {
+	uint64_t size;
+	uint32_t flags;
+	uint32_t handle;
+};
+
+struct msm_gem_info {
+	uint32_t handle;
+	uint32_t info;
+	uint64_t value;
+	uint32_t len;
+	uint32_t pad;
+};
+
+struct msm_gem_cpu_prep {
+	uint32_t handle;
+	uint32_t op;
+	struct msm_timespec timeout;
+};
+
+struct msm_gem_submit {
+	uint32_t flags;
+	uint32_t fence;
+	uint32_t nr_bos;
+	uint32_t nr_cmds;
+	uint64_t bos;
+	uint64_t cmds;
+	int32_t  fence_fd;
+	uint32_t queueid;
+	uint64_t in_syncobjs;
+	uint64_t out_syncobjs;
+	uint32_t nr_in_syncobjs;
+	uint32_t nr_out_syncobjs;
+	uint32_t syncobj_stride;
+	uint32_t pad;
+};
+
+struct msm_wait_fence {
+	uint32_t fence;
