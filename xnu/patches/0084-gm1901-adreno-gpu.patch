+class IOAcceleratorUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOAcceleratorUserClient);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorUserClient, IOUserClient);
+
+bool
+IOAcceleratorUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	return IOUserClient::initWithTask(owningTask, securityID, type);
+}
+
+bool
+IOAcceleratorUserClient::start(IOService *provider)
+{
+	return IOUserClient::start(provider);
+}
+
+IOReturn
+IOAcceleratorUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOAcceleratorUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	return kIOReturnSuccess;
+}
+
+class AGXDeviceUserClient : public IOAcceleratorUserClient {
+	OSDeclareDefaultStructors(AGXDeviceUserClient);
+
+public:
+	AGXAccelerator *fDriver;
+	task_t          fTask;
+
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AGXDeviceUserClient, IOAcceleratorUserClient);
+
+bool
+AGXDeviceUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOAcceleratorUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fDriver = NULL;
+	return true;
+}
+
+bool
+AGXDeviceUserClient::start(IOService *provider)
+{
+	fDriver = OSDynamicCast(AGXAccelerator, provider);
+	if (fDriver == NULL || !IOAcceleratorUserClient::start(provider)) {
+		return false;
+	}
+	return true;
+}
+
+IOReturn
+AGXDeviceUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AGXDeviceUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	if (args->scalarOutputCount > 0) {
+		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+			args->scalarOutput[i] = 0;
+		}
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	switch (selector) {
+	case 0: /* Open / Initialize Context */
+		if (args->scalarOutputCount > 0) {
+			args->scalarOutput[0] = 1; /* context token */
+		}
+		break;
+	case 1: /* Close Context */
+		break;
+	case 2: /* Create Command Queue */
+		if (args->scalarOutputCount > 0) {
+			args->scalarOutput[0] = 1; /* queue id */
+		}
+		break;
+	case 7: /* Get Device Capabilities / Config */
+		if (args->scalarOutputCount >= 2) {
+			args->scalarOutput[0] = CHIP_ID_ADRENO_640;
+			args->scalarOutput[1] = 0x00010000; /* feature flags */
+		}
+		break;
+	case 9: /* Allocate Shared Surface Memory */
+		if (args->scalarOutputCount > 0) {
+			args->scalarOutput[0] = 0x1000;
+		}
+		break;
+	case 12: /* Set Surface */
+	case 14: /* Get Surface */
+	case 17: /* Sync Token */
+	case 20: /* Flush Pipeline */
+	default:
+		break;
+	}
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
