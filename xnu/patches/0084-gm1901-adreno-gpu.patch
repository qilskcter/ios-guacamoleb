+class SweetAcceleratorUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetAcceleratorUserClient);
+
+public:
+	SweetAccelerator        *fDriver;
+	task_t                   fTask;
+	struct sweet_gem_buffer *fBuffers;
+	IOLock                  *fLock;
+	uint32_t                 fLastFence;
+	uint32_t                 fNextQueue;
+
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+
+	struct sweet_gem_buffer *findBuffer(uint32_t handle);
+	IOReturn gemNew(struct msm_gem_new *req);
+	IOReturn gemInfo(struct msm_gem_info *req);
+	IOReturn gemClose(uint32_t handle);
+};
+
+OSDefineMetaClassAndStructors(SweetAcceleratorUserClient, IOUserClient);
+
+bool
+SweetAcceleratorUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fDriver = NULL;
+	fLastFence = 0;
+	fNextQueue = 0;
+	fLock = IOLockAlloc();
+	fBuffers = (struct sweet_gem_buffer *)IOMallocZero(sizeof(struct sweet_gem_buffer) * GPU_BUFFERS);
+	return (fBuffers != NULL && fLock != NULL);
+}
+
+bool
+SweetAcceleratorUserClient::start(IOService *provider)
+{
+	fDriver = OSDynamicCast(SweetAccelerator, provider);
+	if (fDriver == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	return true;
+}
+
+void
+SweetAcceleratorUserClient::free()
+{
+	if (fBuffers != NULL) {
+		for (uint32_t i = 1; i < GPU_BUFFERS; i++) {
+			if (fBuffers[i].memory != NULL) {
+				fBuffers[i].memory->release();
+				fBuffers[i].memory = NULL;
+			}
+		}
+		IOFree(fBuffers, sizeof(struct sweet_gem_buffer) * GPU_BUFFERS);
+		fBuffers = NULL;
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+SweetAcceleratorUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+struct sweet_gem_buffer *
+SweetAcceleratorUserClient::findBuffer(uint32_t handle)
+{
+	if (handle >= 1 && handle < GPU_BUFFERS && fBuffers[handle].memory != NULL) {
+		return &fBuffers[handle];
+	}
+	return NULL;
+}
+
+IOReturn
+SweetAcceleratorUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	if (options) {
+		*options = 0;
+	}
+	if (memory == NULL) {
+		return kIOReturnBadArgument;
+	}
+	*memory = NULL;
+
+	IOLockLock(fLock);
+	struct sweet_gem_buffer *b = findBuffer(type);
+	if (b == NULL || b->memory == NULL) {
+		IOLockUnlock(fLock);
+		return kIOReturnBadArgument;
+	}
+	*memory = b->memory;
+	(*memory)->retain();
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAcceleratorUserClient::gemNew(struct msm_gem_new *req)
+{
+	if (req == NULL || req->size == 0 || req->size > (256ULL << 20)) {
+		return kIOReturnBadArgument;
+	}
+	uint64_t size = round_page(req->size);
+
+	IOLockLock(fLock);
+	uint32_t handle = 0;
+	for (uint32_t i = 1; i < GPU_BUFFERS; i++) {
+		if (fBuffers[i].memory == NULL) {
+			handle = i;
+			break;
+		}
+	}
+	if (handle == 0) {
+		IOLockUnlock(fLock);
+		return kIOReturnNoMemory;
+	}
+
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(
+	    kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared, size, PAGE_SIZE);
+	if (mem == NULL) {
+		IOLockUnlock(fLock);
+		return kIOReturnNoMemory;
+	}
+
+	void *kva = mem->getBytesNoCopy();
+	if (kva != NULL) {
+		bzero(kva, size);
+	}
+
+	struct sweet_gem_buffer *b = &fBuffers[handle];
+	b->handle = handle;
+	b->size = size;
+	b->flags = req->flags;
+	b->memory = mem;
+	b->kva = kva;
+	b->address = GPU_VA_BASE + (uint64_t)handle * GPU_VA_STRIDE;
+
+	req->handle = handle;
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAcceleratorUserClient::gemInfo(struct msm_gem_info *req)
+{
+	if (req == NULL) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	struct sweet_gem_buffer *b = findBuffer(req->handle);
+	if (b == NULL) {
+		IOLockUnlock(fLock);
+		return kIOReturnBadArgument;
+	}
+	switch (req->info) {
+	case MSM_INFO_GET_OFFSET:
+		req->value = req->handle;
+		break;
+	case MSM_INFO_GET_IOVA:
+		req->value = b->address;
+		break;
+	case MSM_INFO_GET_FLAGS:
+		req->value = b->flags;
+		break;
+	default:
+		req->value = 0;
+		break;
+	}
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAcceleratorUserClient::gemClose(uint32_t handle)
+{
+	IOLockLock(fLock);
+	struct sweet_gem_buffer *b = findBuffer(handle);
+	if (b == NULL) {
+		IOLockUnlock(fLock);
+		return kIOReturnBadArgument;
+	}
+	if (b->memory != NULL) {
+		b->memory->release();
+		b->memory = NULL;
+	}
+	bzero(b, sizeof(*b));
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAcceleratorUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	if (args == NULL) {
+		return kIOReturnBadArgument;
+	}
+
+	/* Zero scalar and structure outputs by default */
+	if (args->scalarOutputCount > 0 && args->scalarOutput != NULL) {
+		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+			args->scalarOutput[i] = 0;
+		}
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL && args->structureOutputSize > 0) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	/* 1. Linux MSM DRM / freedreno requests */
+	switch (selector) {
+	case kMsmGetParam: {
+		if (args->structureInput == NULL || args->structureInputSize < sizeof(struct msm_param)) {
+			return kIOReturnBadArgument;
+		}
+		struct msm_param p;
+		memcpy(&p, args->structureInput, sizeof(p));
+		switch (p.param) {
+		case MSM_PARAM_GPU_ID:
+			p.value = 640;
+			break;
+		case MSM_PARAM_CHIP_ID:
+			p.value = CHIP_ID_ADRENO_640;
+			break;
+		case MSM_PARAM_MAX_FREQ:
+			p.value = 585000000ULL;
+			break;
+		case MSM_PARAM_TIMESTAMP:
+			p.value = mach_absolute_time();
+			break;
+		case MSM_PARAM_VA_START:
+			p.value = GPU_VA_BASE;
+			break;
+		case MSM_PARAM_VA_SIZE:
+			p.value = 0x400000000ULL;
+			break;
+		default:
+			p.value = 0;
+			break;
+		}
+		if (args->structureOutput != NULL && args->structureOutputSize >= sizeof(p)) {
+			memcpy(args->structureOutput, &p, sizeof(p));
+		}
+		return kIOReturnSuccess;
+	}
+	case kMsmGemNew: {
+		if (args->structureInput == NULL || args->structureInputSize < sizeof(struct msm_gem_new)) {
+			return kIOReturnBadArgument;
+		}
+		struct msm_gem_new req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		IOReturn ret = gemNew(&req);
+		if (ret == kIOReturnSuccess && args->structureOutput != NULL && args->structureOutputSize >= sizeof(req)) {
+			memcpy(args->structureOutput, &req, sizeof(req));
+		}
+		return ret;
+	}
+	case kMsmGemInfo: {
+		if (args->structureInput == NULL || args->structureInputSize < sizeof(struct msm_gem_info)) {
+			return kIOReturnBadArgument;
+		}
+		struct msm_gem_info req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		IOReturn ret = gemInfo(&req);
+		if (ret == kIOReturnSuccess && args->structureOutput != NULL && args->structureOutputSize >= sizeof(req)) {
+			memcpy(args->structureOutput, &req, sizeof(req));
+		}
+		return ret;
+	}
+	case kMsmGemCpuPrep: {
+		if (args->structureInput == NULL || args->structureInputSize < sizeof(struct msm_gem_cpu_prep)) {
+			return kIOReturnBadArgument;
+		}
+		struct msm_gem_cpu_prep req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		IOLockLock(fLock);
+		struct sweet_gem_buffer *b = findBuffer(req.handle);
+		if (b != NULL && b->kva != NULL) {
+			/* Clean and invalidate data cache */
+			uintptr_t p = (uintptr_t)b->kva;
+			uintptr_t end = p + b->size;
+			while (p < end) {
+				__asm__ volatile("dc civac, %0" : : "r"(p) : "memory");
+				p += 64;
+			}
+			__asm__ volatile("dsb ish" ::: "memory");
+		}
+		IOLockUnlock(fLock);
+		return kIOReturnSuccess;
+	}
+	case kMsmGemCpuFini:
+	case kMsmSetParam:
+	case kMsmSubmitQueueClose:
+		return kIOReturnSuccess;
+
+	case kMsmGemSubmit: {
+		if (args->structureInput == NULL || args->structureInputSize < sizeof(struct msm_gem_submit)) {
+			return kIOReturnBadArgument;
+		}
+		struct msm_gem_submit req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		IOLockLock(fLock);
+		req.fence = ++fLastFence;
+		IOLockUnlock(fLock);
+		if (args->structureOutput != NULL && args->structureOutputSize >= sizeof(req)) {
+			memcpy(args->structureOutput, &req, sizeof(req));
+		}
+		return kIOReturnSuccess;
+	}
+	case kMsmWaitFence: {
+		if (args->structureInput == NULL || args->structureInputSize < sizeof(struct msm_wait_fence)) {
+			return kIOReturnBadArgument;
+		}
+		struct msm_wait_fence req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		if ((int32_t)(req.fence - fLastFence) > 0) {
+			return kIOReturnBadArgument;
+		}
+		return kIOReturnSuccess;
+	}
+	case kMsmSubmitQueueNew: {
+		if (args->structureInput != NULL && args->structureInputSize >= sizeof(struct msm_submitqueue)) {
+			struct msm_submitqueue q;
+			memcpy(&q, args->structureInput, sizeof(q));
+			q.id = ++fNextQueue;
+			if (args->structureOutput != NULL && args->structureOutputSize >= sizeof(q)) {
+				memcpy(args->structureOutput, &q, sizeof(q));
+			}
+		}
+		return kIOReturnSuccess;
+	}
+	case kMsmSubmitQueueQuery: {
+		if (args->structureInput != NULL && args->structureInputSize >= sizeof(struct msm_submitqueue_query)) {
+			struct msm_submitqueue_query q;
+			memcpy(&q, args->structureInput, sizeof(q));
+			uint64_t zero = 0;
+			if (q.data != 0 && q.len >= sizeof(zero)) {
+				copyout(&zero, (user_addr_t)q.data, sizeof(zero));
+			}
+		}
+		return kIOReturnSuccess;
+	}
+	case kDrmGemClose: {
+		if (args->structureInput == NULL || args->structureInputSize < sizeof(struct drm_gem_close)) {
+			return kIOReturnBadArgument;
+		}
+		struct drm_gem_close req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		return gemClose(req.handle);
+	}
+	case kHakiosSurface: {
+		if (args->structureInput == NULL || args->structureInputSize < sizeof(struct hakios_surface)) {
+			return kIOReturnBadArgument;
+		}
+		struct hakios_surface req;
+		memcpy(&req, args->structureInput, sizeof(req));
+		/* Wrap or describe IOSurface */
+		req.handle = 1; /* default surface slot */
+		req.offset = 0;
+		req.rowBytes = 1080 * 4;
+		req.width = 1080;
+		req.height = 2340;
+		req.size = (uint64_t)req.rowBytes * req.height;
+		req.pixelFormat = 0x42475241; /* BGRA */
+		req.planes = 1;
+		if (args->structureOutput != NULL && args->structureOutputSize >= sizeof(req)) {
+			memcpy(args->structureOutput, &req, sizeof(req));
+		}
+		return kIOReturnSuccess;
+	}
+	case kHakiosShow:
+		return kIOReturnSuccess;
+
+	/* 2. Apple legacy IOAccelerator selectors */
+	case 0:
+	case 2:
+		if (args->scalarOutputCount > 0) {
+			args->scalarOutput[0] = 1;
+		}
+		return kIOReturnSuccess;
+	case 1:
+		return kIOReturnSuccess;
+	case 7:
+		if (args->scalarOutputCount >= 2) {
+			args->scalarOutput[0] = CHIP_ID_ADRENO_640;
+			args->scalarOutput[1] = 0x00010000;
+		}
+		return kIOReturnSuccess;
+	
+		if (args->scalarOutputCount > 0) {
+			args->scalarOutput[0] = 0x1000;
+		}
+		return kIOReturnSuccess;
+	case 12:
+	case 14:
+	case 17:
+	case 20:
+		return kIOReturnSuccess;
+	default:
+		break;
+	}
+
+	return kIOReturnSuccess;
+}
+#endif /* SWEET */
