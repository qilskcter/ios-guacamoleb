+class SweetAccelerator : public IOService {
+	OSDeclareDefaultStructors(SweetAccelerator);
+
+public:
+	volatile uint32_t *fGpuccBase;
+	volatile uint32_t *fGpuBase;
+	volatile uint32_t *fGmuBase;
+	uint32_t           fChipId;
+	IOLock            *fLock;
+
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+	void boostCPUClocks();
+	bool powerOnGPU();
+	uint32_t readChipID();
+};
+
+OSDefineMetaClassAndStructors(SweetAccelerator, IOService);
+
+bool
+SweetAccelerator::init(OSDictionary *dictionary)
+{
+	if (!IOService::init(dictionary)) {
+		return false;
+	}
+	fGpuccBase = NULL;
+	fGpuBase = NULL;
+	fGmuBase = NULL;
+	fChipId = CHIP_ID_ADRENO_640;
+	fLock = NULL;
+	return true;
+}
+
+void
+SweetAccelerator::free()
+{
+	if (fLock) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOService::free();
+}
+
+void
+SweetAccelerator::boostCPUClocks()
+{
+	uintptr_t osm_base = (uintptr_t)ml_io_map(SM8150_OSM_PHYS_BASE, SM8150_OSM_MAP_SIZE);
+	if (osm_base == 0) {
+		IOLog("SWEET CPU: Failed to map SM8150 OSM\n");
+		return;
+	}
+	static const uint32_t dom_offsets[4] = {
+		OSM_OFF_L3, OSM_OFF_SILVER, OSM_OFF_GOLD, OSM_OFF_PRIME
+	};
+	static const char *dom_names[4] = {
+		"L3", "Silver", "Gold", "Prime"
+	};
+	for (int d = 0; d < 4; d++) {
+		uintptr_t dom = osm_base + dom_offsets[d];
+		uint32_t max_idx = 0;
+		uint32_t prev_lval = 0, prev_src = 0;
+		uint32_t max_lval = 0;
+		for (uint32_t i = 0; i < OSM_LUT_MAX_ROWS; i++) {
+			uint32_t val = *(volatile uint32_t *)(dom + OSM_REG_LUT_BASE + i * OSM_LUT_ROW_STRIDE);
+			uint32_t lval = val & 0xffU;
+			uint32_t src = (val >> 30) & 0x3U;
+			if (lval == 0 && src == 0) {
+				break;
+			}
+			if (i > 0 && lval == prev_lval && src == prev_src) {
+				break;
+			}
+			max_idx = i;
+			max_lval = lval;
+			prev_lval = lval;
+			prev_src = src;
+		}
+		if (max_idx == 0) {
+			max_idx = (d == 1) ? 14 : 15;
+			max_lval = (d == 1) ? 93 : 148;
+		}
+		uint32_t old_idx = *(volatile uint32_t *)(dom + OSM_REG_PERF_DESIRED);
+		*(volatile uint32_t *)(dom + OSM_REG_PERF_DESIRED) = max_idx;
+		__asm__ volatile("dsb sy" ::: "memory");
+		uint32_t readback = *(volatile uint32_t *)(dom + OSM_REG_PERF_DESIRED);
+		IOLog("SWEET CPU: %s OSM idx %u -> %u (readback %u, ~%u MHz)\n",
+		    dom_names[d], old_idx & 0x3fU, max_idx, readback & 0x3fU, (max_lval * 192U) / 10U);
+	}
+}
+
+bool
+SweetAccelerator::powerOnGPU()
+{
+	fGpuccBase = (volatile uint32_t *)ml_io_map(ADRENO_GPUCC_BASE_PHYS, ADRENO_GPUCC_SIZE);
+	if (fGpuccBase == NULL) {
+		IOLog("SWEET GPU: Failed to map GPUCC\n");
+		return false;
+	}
+
+	volatile uint32_t *cx_gdsc = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_CX_GDSC_OFFSET);
+	volatile uint32_t *gx_gdsc = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_GX_GDSC_OFFSET);
+	volatile uint32_t *ahb_clk = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_AHB_CLK_OFFSET);
+	volatile uint32_t *gmu_clk = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_CX_GMU_OFFSET);
+	volatile uint32_t *gfx_clk = (volatile uint32_t *)((uintptr_t)fGpuccBase + GPUCC_GX_GFX3D_OFFSET);
+
+	/* Enable CX GDSC */
+	*cx_gdsc |= 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (int i = 0; i < 5000; i++) {
+		if (*cx_gdsc & 0x80000000U) break;
+		IODelay(1);
+	}
+
+	/* Enable AHB and GMU branch clocks */
+	*ahb_clk |= 1;
+	*gmu_clk |= 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* Enable GX GDSC (3D graphics core) */
+	*gx_gdsc |= 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (int i = 0; i < 5000; i++) {
+		if (*gx_gdsc & 0x80000000U) break;
+		IODelay(1);
+	}
+
+	/* Enable GFX3D core clock */
+	*gfx_clk |= 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	IOLog("SWEET GPU: Hardware clocks and GDSC active\n");
+	return true;
+}
+
+uint32_t
+SweetAccelerator::readChipID()
+{
+	if (fGpuBase != NULL) {
+		uint32_t id = *fGpuBase;
+		if (id != 0 && id != 0xffffffffU) {
+			return id;
+		}
+	}
+	return CHIP_ID_ADRENO_640;
+}
+
+bool
+SweetAccelerator::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+
+	fLock = IOLockAlloc();
+	boostCPUClocks();
+	powerOnGPU();
+	fGmuBase = (volatile uint32_t *)ml_io_map(ADRENO_GMU_BASE_PHYS, ADRENO_GMU_SIZE);
+	fGpuBase = (volatile uint32_t *)ml_io_map(ADRENO_GPU_BASE_PHYS, ADRENO_GPU_SIZE);
+	fChipId = readChipID();
+	IOLog("SWEET GPU: Adreno 640 hardware accelerator active\n");
+
+	setName("SweetAccelerator");
+	setProperty("IOGPUDevice", kOSBooleanTrue);
+	setProperty("IOGPUFamily", "Generic");
+	setProperty("IOGPUGL", kOSBooleanTrue);
+	setProperty("IOGPUMetal", kOSBooleanTrue);
+	setProperty("MetalPluginName", "HakiosMetal");
+	setProperty("MetalPluginClassName", "HakiosMetalDevice");
+	setProperty("IOGPUNumCommandQueues", 4ULL, 32);
+	setProperty("IOGPUMaxSurfaces", 64ULL, 32);
+	setProperty("IOGPUGlobalSharedStorageSize", 0x10000000ULL, 64);
+	setProperty("IOGPUFeatureFlags", 0x1fULL, 32);
+	setProperty("IOGPUPerformanceLevel", 3ULL, 32);
+	setProperty("IOUserClientClass", "SweetAcceleratorUserClient");
+
+	registerService();
+	return true;
+}
+
+void
+SweetAccelerator::stop(IOService *provider)
+{
+	IOService::stop(provider);
+}
